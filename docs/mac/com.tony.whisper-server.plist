<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tony.whisper-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/whisper-server</string>
        <string>-m</string>
        <string>/Users/tony/.summarize/models/ggml-large-v3-turbo.bin</string>
        <string>--host</string>
